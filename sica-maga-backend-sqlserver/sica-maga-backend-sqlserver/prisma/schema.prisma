generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.VarChar(255)
  usuarios    Usuario[]

  @@map("Roles")
}

model Departamento {
  id          Int         @id @default(autoincrement())
  codigo      String      @unique @db.VarChar(10)
  nombre      String      @db.VarChar(100)
  municipios  Municipio[]
  parcelas    Parcela[]
  productores Productor[]
  usuarios    Usuario[]

  @@map("Departamentos")
}

model Municipio {
  id             Int          @id @default(autoincrement())
  codigo         String       @db.VarChar(10)
  nombre         String       @db.VarChar(100)
  departamentoId Int
  comunidades    Comunidad[]
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onUpdate: NoAction)
  parcelas       Parcela[]
  productores    Productor[]
  usuarios       Usuario[]

  @@map("Municipios")
}

model Comunidad {
  id          Int         @id @default(autoincrement())
  nombre      String      @db.VarChar(100)
  municipioId Int
  municipio   Municipio   @relation(fields: [municipioId], references: [id], onUpdate: NoAction)
  productores Productor[]

  @@map("Comunidades")
}

model Usuario {
  id             Int            @id @default(autoincrement())
  nombre         String         @db.VarChar(100)
  correo         String         @unique @db.VarChar(100)
  password       String         @db.VarChar(255)
  activo         Boolean        @default(true)
  rolId          Int
  departamentoId Int?
  municipioId    Int?
  refreshTokens  RefreshToken[]
  departamento   Departamento?  @relation(fields: [departamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  municipio      Municipio?     @relation(fields: [municipioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rol            Rol            @relation(fields: [rolId], references: [id], onUpdate: NoAction)

  @@map("Usuarios")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  usuarioId Int
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("RefreshTokens")
}

model Productor {
  id             Int          @id @default(autoincrement())
  cui            String       @unique @db.VarChar(13)
  nombres        String       @db.VarChar(100)
  apellidos      String       @db.VarChar(100)
  telefono       String?      @db.VarChar(20)
  direccion      String?      @db.VarChar(255)
  cooperativa    String?      @db.VarChar(150)
  fechaRegistro  DateTime     @default(now())
  departamentoId Int
  municipioId    Int
  comunidadId    Int?
  parcelas       Parcela[]
  comunidad      Comunidad?   @relation(fields: [comunidadId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departamento   Departamento @relation(fields: [departamentoId], references: [id], onUpdate: NoAction)
  municipio      Municipio    @relation(fields: [municipioId], references: [id], onUpdate: NoAction)

  @@map("Productores")
}

model Parcela {
  id              Int             @id @default(autoincrement())
  codigo          String          @unique @db.VarChar(50)
  extension       Decimal         @db.Decimal(10, 2)
  tenenciaTierra  String          @db.VarChar(50)
  latitud         Float
  longitud        Float
  fechaRegistro   DateTime        @default(now())
  productorId     Int
  departamentoId  Int
  municipioId     Int
  cosechas        Cosecha[]
  fertilizaciones Fertilizacion[]
  incidencias     Incidencia[]
  departamento    Departamento    @relation(fields: [departamentoId], references: [id], onUpdate: NoAction)
  municipio       Municipio       @relation(fields: [municipioId], references: [id], onUpdate: NoAction)
  productor       Productor       @relation(fields: [productorId], references: [id], onUpdate: NoAction)

  @@map("Parcelas")
}

model Cultivo {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(100)
  descripcion String?   @db.VarChar(255)
  cosechas    Cosecha[]

  @@map("Cultivos")
}

model Cosecha {
  id              Int             @id @default(autoincrement())
  temporada       String          @db.VarChar(50)
  produccionEst   Decimal         @db.Decimal(10, 2)
  produccionReal  Decimal?        @db.Decimal(10, 2)
  fechaSiembra    DateTime
  fechaCosecha    DateTime?
  parcelaId       Int
  cultivoId       Int
  cultivo         Cultivo         @relation(fields: [cultivoId], references: [id], onUpdate: NoAction)
  parcela         Parcela         @relation(fields: [parcelaId], references: [id], onUpdate: NoAction)
  fertilizaciones Fertilizacion[]
  incidencias     Incidencia[]

  @@map("Cosechas")
}

model TipoFertilizante {
  id              Int             @id @default(autoincrement())
  nombre          String          @db.VarChar(100)
  fertilizaciones Fertilizacion[]

  @@map("TiposFertilizantes")
}

model Fertilizacion {
  id              Int              @id @default(autoincrement())
  cantidad        Decimal          @db.Decimal(10, 2)
  fechaAplicacion DateTime
  fechaRegistro   DateTime         @default(now())
  parcelaId       Int
  cosechaId       Int?
  fertilizanteId  Int
  cosecha         Cosecha?         @relation(fields: [cosechaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fertilizante    TipoFertilizante @relation(fields: [fertilizanteId], references: [id], onUpdate: NoAction)
  parcela         Parcela          @relation(fields: [parcelaId], references: [id], onUpdate: NoAction)

  @@map("Fertilizaciones")
}

model Plaga {
  id          Int          @id @default(autoincrement())
  nombre      String       @db.VarChar(100)
  incidencias Incidencia[]

  @@map("Plagas")
}

model Incidencia {
  id            Int      @id @default(autoincrement())
  descripcion   String   @db.VarChar(255)
  severidad     String   @db.VarChar(50)
  fechaRegistro DateTime @default(now())
  parcelaId     Int
  cosechaId     Int?
  plagaId       Int?
  cosecha       Cosecha? @relation(fields: [cosechaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parcela       Parcela  @relation(fields: [parcelaId], references: [id], onUpdate: NoAction)
  plaga         Plaga?   @relation(fields: [plagaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("Incidencias")
}

model sysdiagrams {
  name         String @db.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id(map: "PK__sysdiagr__C2B05B610BB16E1A") @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name], map: "UK_principal_name")
}
